# Virtual environments
venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Environment
.env
.env.local

# Orchestrator
orchestrator/*.log
orchestrator/.langgraph/
.langgraph/

# Frontend build artifacts
frontend/node_modules/
frontend/dist/
# Exception: frontend source lib/ is not a Python lib dir
!frontend/src/lib/
# Exception: builder's shared TS helpers dir is not a Python lib dir either
!builder/lib/

# Built frontend artifacts. .github/workflows/deploy-pages.yml builds these
# on demand and uploads them as a Pages artifact — no need to commit. Local
# `npm run build` puts the output here too; ignore it.
docs/
data/indexes/events/

# Builder dry-run output
.dry-run-prompts/

# Verifier transient output
builder/scripts/__fixtures__/*.actual

# Retired run-log path — telemetry now stays in each agent's ephemeral work
# directory ($WORK_DIR/<source_id>/notes.md). Keep ignored so stray local
# files never re-enter version control.
data/run-logs/

# Hermes Agent — local-only, never tracked
.hermes/

# CLI — compressed data blobs generated by cli/scripts/prepare-data.sh
cli/embed/*.gz

# CLI — build output binaries
osintcli-*

# Vibe agent runtime (temporary / local symlinks)
.vibe/
.vibe-tasks/
.vibe-runs/

# nektos/act local runner config
.actrc
.act.secrets
.act.vars
